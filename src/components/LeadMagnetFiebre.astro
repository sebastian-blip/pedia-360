---
import LeadEmailCapture from "./LeadEmailCapture.astro";

interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = "¿Tu hijo tiene fiebre?",
  subtitle = "Responde esta guía rápida para saber si debes llevarlo a urgencias."
} = Astro.props;
---

<div class="lead-magnet" data-lead-magnet>
  <LeadEmailCapture
    source="fiebre"
    title="Ingresa tu correo para comenzar"
    subtitle="Recibe un resumen de esta guía y descubre la oferta especial que tenemos para ti."
    buttonText="Comenzar evaluación"
  />

  <div class="lead-magnet-card is-hidden" data-lead-card hidden>
    <div class="lead-magnet-header">
      <h2>{title}</h2>
      <p>{subtitle}</p>
    </div>

    <div class="progress-bar" data-progress-bar>
      <div class="progress-fill" data-progress-fill></div>
    </div>

    <form class="lead-magnet-form is-hidden" data-lead-form novalidate hidden>
      <!-- Pregunta 1 -->
      <fieldset class="question-step" data-step="1" data-question="age">
        <legend class="question-title">
          <span class="question-number">1</span>
          ¿Qué edad tiene tu hijo?
        </legend>
        <div class="options">
          <label class="option-card">
            <input type="radio" name="age" value="0-3" required />
            <span class="option-text">0 a 3 meses</span>
          </label>
          <label class="option-card">
            <input type="radio" name="age" value="over3" required />
            <span class="option-text">Más de 3 meses</span>
          </label>
        </div>
      </fieldset>

      <!-- Pregunta 2 -->
      <fieldset class="question-step" data-step="2" data-question="measured" hidden>
        <legend class="question-title">
          <span class="question-number">2</span>
          ¿Ya tomaste la temperatura con termómetro?
        </legend>
        <div class="options">
          <label class="option-card">
            <input type="radio" name="measured" value="yes" required />
            <span class="option-text">Sí</span>
          </label>
          <label class="option-card">
            <input type="radio" name="measured" value="no" required />
            <span class="option-text">No</span>
          </label>
        </div>
        <div class="feedback" data-feedback="measured" hidden></div>
      </fieldset>

      <!-- Pregunta 3 -->
      <fieldset class="question-step" data-step="3" data-question="temperature" hidden>
        <legend class="question-title">
          <span class="question-number">3</span>
          ¿Qué temperatura te dio?
        </legend>
        <div class="options">
          <label class="option-card">
            <input type="radio" name="temperature" value="less37-5" required />
            <span class="option-text">Menor a 37,5 °C</span>
          </label>
          <label class="option-card">
            <input type="radio" name="temperature" value="37-5-38" required />
            <span class="option-text">37,5 a 38 °C</span>
          </label>
          <label class="option-card">
            <input type="radio" name="temperature" value="38-39" required />
            <span class="option-text">Entre 38 a 39 °C</span>
          </label>
          <label class="option-card">
            <input type="radio" name="temperature" value="over39" required />
            <span class="option-text">Mayor a 39 °C</span>
          </label>
        </div>
        <div class="feedback" data-feedback="temperature" hidden></div>
      </fieldset>

      <!-- Pregunta 4 -->
      <fieldset class="question-step" data-step="4" data-question="acetaminophen" hidden>
        <legend class="question-title">
          <span class="question-number">4</span>
          ¿Ya diste acetaminofén?
        </legend>
        <div class="options">
          <label class="option-card">
            <input type="radio" name="acetaminophen" value="yes" required />
            <span class="option-text">Sí</span>
          </label>
          <label class="option-card">
            <input type="radio" name="acetaminophen" value="no" required />
            <span class="option-text">No</span>
          </label>
        </div>
        <div class="feedback" data-feedback="acetaminophen" hidden></div>
      </fieldset>

      <!-- Pregunta 5 -->
      <fieldset class="question-step" data-step="5" data-question="symptoms" hidden>
        <legend class="question-title">
          <span class="question-number">5</span>
          Además de la fiebre, tu hijo tiene <em>(selecciona una o varias)</em>:
        </legend>
        <div class="options options-multi">
          <label class="option-card">
            <input type="checkbox" name="symptoms" value="breathing" />
            <span class="option-text">Dificultad para respirar, se coloca morado o agitado</span>
          </label>
          <label class="option-card">
            <input type="checkbox" name="symptoms" value="vomit-diarrhea" />
            <span class="option-text">Vómito o diarrea más de 4 veces en 4 horas</span>
          </label>
          <label class="option-card">
            <input type="checkbox" name="symptoms" value="no-drinks" />
            <span class="option-text">No quiere recibir ninguna bebida, ni suero ni teta o tetero</span>
          </label>
          <label class="option-card">
            <input type="checkbox" name="symptoms" value="more3days" />
            <span class="option-text">Lleva más de 3 días con fiebre y no tiene más síntomas</span>
          </label>
          <label class="option-card">
            <input type="checkbox" name="symptoms" value="uncontrolled" />
            <span class="option-text">No logras controlar la fiebre por lo menos 4 horas después de dar el acetaminofén</span>
          </label>
          <label class="option-card">
            <input type="checkbox" name="symptoms" value="none" />
            <span class="option-text">Ninguna</span>
          </label>
        </div>
        <div class="feedback" data-feedback="symptoms" hidden></div>
      </fieldset>

      <!-- Resumen -->
      <div class="summary-step" data-step="summary" hidden>
        <div class="summary-header">
          <h3>Recomendación</h3>
          <p>Esta es la orientación según tus respuestas.</p>
        </div>
        <div class="summary-content" data-summary-content></div>
      </div>

      <!-- Finalización -->
      <div class="complete-step" data-step="complete" hidden>
        <div class="complete-icon">🩺</div>
        <div class="complete-header">
          <h3>¡Gracias por completar la guía!</h3>
          <p>
            Recuerda que esta herramienta es orientativa. Si tienes dudas o el estado de tu hijo cambia, consulta a tu pediatra o acude a urgencias.
            Te llevamos a conocer la oferta especial de Black Friday que tenemos para ti.
          </p>
        </div>
      </div>

      <div class="actions">
        <button class="lm-btn lm-btn-primary lm-btn-lg" type="button" data-next-btn>
          Continuar
        </button>
        <button class="lm-btn lm-btn-outline lm-btn-md" type="button" data-prev-btn hidden>
          Volver
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const containers = document.querySelectorAll("[data-lead-magnet]");

    containers.forEach((container) => {
      const form = container.querySelector("[data-lead-form]");
      const steps = container.querySelectorAll("[data-step]");
      const nextBtn = container.querySelector("[data-next-btn]");
      const prevBtn = container.querySelector("[data-prev-btn]");
      const progressFill = container.querySelector("[data-progress-fill]");
      const summaryContent = container.querySelector("[data-summary-content]");

      const TOTAL_QUESTIONS = 5;
      let currentStep = 1;
      const answers = {};
      const feedbacks = {};

      const messages = {
        measured: {
          "0-3_no":
            "Toma la temperatura con un termómetro digital y si da más de 37.5, dado que tu bebé es muy pequeño la posibilidad que tenga una infección importante es ALTA así que dirígete a urgencias de INMEDIATO.",
          over3_no:
            "Con un termómetro digital toma la temperatura, porque guiarte tocando tu bebé no es confiable: puede estar frío al tacto y tener temperatura muy alta, o por el contrario estar calientito y no tenerla tan alta.",
        },
        temperature: {
          "0-3_less37-5":
            "Por ahora no tiene fiebre, pero podría subirle así que tómale la temperatura frecuentemente y vigila. Si le sube ve a urgencias.",
          "0-3_37-5-38":
            "Dado que tu bebé es muy pequeño la posibilidad que tenga una infección importante es ALTA así que dirígete a urgencias de INMEDIATO.",
          "0-3_38-39":
            "Dado que tu bebé es muy pequeño la posibilidad que tenga una infección importante es ALTA así que dirígete a urgencias de INMEDIATO.",
          "0-3_over39":
            "Dado que tu bebé es muy pequeño la posibilidad que tenga una infección importante es ALTA así que dirígete a urgencias de INMEDIATO.",
          "over3_less37-5":
            "Tu bebé no tiene fiebre, pero es probable que al tocarlo lo sientas más caliente. Esto sucede cuando van a iniciar a enfermarse, así que toma la temperatura cada 4 horas para hacerle seguimiento.",
          "over3_37-5-38":
            "Tiene febrícula. Si tu bebé está tranquilo, no parece dolerle nada, puedes tomar la temperatura en media hora y mirar si sube a más de 38 y ahí darle acetaminofén. Pero si lo ves maluco o incómodo puedes darle ya acetaminofén.",
          "over3_38-39":
            "Tiene fiebre no alta, así que puedes:\n- Dar acetaminofén cada 4 a 6 horas según la fiebre. Verifica la dosis en la caja del medicamento.\n- Hidratarlo muy bien. Si tiene menos de 6 meses con la teta. Si tiene más de 6 meses puedes dar suero oral frecuentemente.",
          "over3_over39":
            "Tiene fiebre alta y debes:\n- Dar acetaminofén cada 4 a 6 horas según la fiebre. Verifica la dosis en la caja del medicamento.\n- Hidratarlo muy bien. Si tiene menos de 6 meses con la teta. Si tiene más de 6 meses puedes dar suero oral frecuentemente.",
        },
        acetaminophen: {
          yes:
            "Muy bien, el acetaminofén empieza a controlar la temperatura a los 15 minutos y puede tardar hasta 1 hora en controlarla.\n\nRecuerda usar un acetaminofén de buena marca porque así hace efecto más rápido. Ejemplo marcas: MK, Cronofen, Dolex, Tylenol.\n\nSi tienes un jarabe abierto en casa y lleva más de 1 mes abierto, deséchalo y compra uno nuevo, porque probablemente perdió su efecto.",
          no:
            "El primer paso es siempre dar acetaminofén, así que empieza por allí.\n\nSi tu bebé está sin dificultad respiratoria, no está agitado, no tiene vómito o diarrea en más de 4 veces y tiene menos de 3 días con fiebre, puedes empezar dando acetaminofén.\n\nTranquila, la fiebre es tu amigo, ayuda a matar el microorganismo que ataca tu bebé. No es cierto que la fiebre alta por sí sola puede causar meningitis o convulsiones. Es un MITO.",
        },
        symptoms: {
          alarm:
            "Ve a urgencias, tu bebé tiene signos de alarma que es importante revisar lo más pronto posible.",
          none:
            "Qué bueno, tu hij@ no tiene signos de alarma, puedes manejarlo en casa hasta que resuelva o aparezca una de las opciones de arriba.",
        },
      };

      function updateProgress() {
        const progress =
          currentStep === "summary" || currentStep === "complete"
            ? 100
            : Math.round(((currentStep - 1) / TOTAL_QUESTIONS) * 100);
        if (progressFill) {
          progressFill.style.width = `${progress}%`;
        }
      }

      function getButtonText(step) {
        if (step === "summary") return "Finalizar";
        if (step === "complete") return "Ver oferta Black Friday";
        return "Continuar";
      }

      function showStep(step) {
        steps.forEach((s) => {
          const stepValue = s.getAttribute("data-step");
          s.hidden = stepValue !== String(step);
        });

        if (nextBtn) {
          nextBtn.textContent = getButtonText(step);
        }

        if (prevBtn) {
          const hidePrev = step === 1 || step === "complete";
          prevBtn.hidden = hidePrev;
          prevBtn.style.display = hidePrev ? "none" : "";
        }

        currentStep = step;
        updateProgress();
      }

      function getCheckboxValues(stepNumber) {
        const stepEl = container.querySelector(`[data-step="${stepNumber}"]`);
        if (!stepEl) return [];
        return Array.from(
          stepEl.querySelectorAll('input[type="checkbox"]:checked')
        ).map((input) => input.value);
      }

      function getFeedback(question, value) {
        const age = answers.age;

        if (question === "measured") {
          const key = age === "0-3" ? `0-3_${value}` : `over3_${value}`;
          return messages.measured[key] || "";
        }

        if (question === "temperature") {
          const key = `${age === "0-3" ? "0-3" : "over3"}_${value}`;
          return messages.temperature[key] || "";
        }

        if (question === "acetaminophen") {
          return messages.acetaminophen[value] || "";
        }

        if (question === "symptoms") {
          const selected = Array.isArray(value) ? value : [];
          const alarmValues = [
            "breathing",
            "vomit-diarrhea",
            "no-drinks",
            "more3days",
            "uncontrolled",
          ];
          const hasAlarm = selected.some((v) => alarmValues.includes(v));
          return hasAlarm ? messages.symptoms.alarm : messages.symptoms.none;
        }

        return "";
      }

      function renderFeedback(question, value) {
        const feedbackEl = container.querySelector(
          `[data-feedback="${question}"]`
        );
        if (!feedbackEl) return;

        const message = getFeedback(question, value);
        if (!message) {
          feedbackEl.hidden = true;
          return;
        }

        feedbackEl.innerHTML = message
          .split("\n")
          .map((line) => `<p>${line}</p>`)
          .join("");
        feedbackEl.hidden = false;
        feedbacks[question] = message;
      }

      function getQuestionLabel(question) {
        const labels = {
          age: "Edad de tu hijo",
          measured: "Temperatura tomada",
          temperature: "Temperatura registrada",
          acetaminophen: "Acetaminofén",
          symptoms: "Signos de alarma",
        };
        return labels[question] || question;
      }

      function formatLines(text) {
        return text
          .split("\n")
          .map((line) => `<p>${line}</p>`)
          .join("");
      }

      function buildSummary() {
        if (!summaryContent) return;

        const ageLabels = {
          "0-3": "0 a 3 meses",
          over3: "Más de 3 meses",
        };

        const tempLabels = {
          "less37-5": "Menor a 37,5 °C",
          "37-5-38": "37,5 a 38 °C",
          "38-39": "Entre 38 a 39 °C",
          over39: "Mayor a 39 °C",
        };

        const symptomLabels = {
          breathing: "Dificultad para respirar / agitado / morado",
          "vomit-diarrhea": "Vómito o diarrea más de 4 veces en 4 horas",
          "no-drinks": "No acepta bebidas",
          more3days: "Más de 3 días con fiebre sin otros síntomas",
          uncontrolled: "Fiebre no controlada después de acetaminofén",
          none: "Ninguna",
        };

        let html = `
          <div class="summary-item">
            <strong>Edad:</strong> ${ageLabels[answers.age] || answers.age}
          </div>
        `;

        if (answers.measured) {
          html += `
            <div class="summary-item">
              <strong>¿Tomó temperatura?</strong> ${answers.measured === "yes" ? "Sí" : "No"}
            </div>
          `;
        }

        if (answers.temperature) {
          html += `
            <div class="summary-item">
              <strong>Temperatura:</strong> ${tempLabels[answers.temperature] || answers.temperature}
            </div>
          `;
        }

        if (answers.acetaminophen) {
          html += `
            <div class="summary-item">
              <strong>¿Dio acetaminofén?</strong> ${answers.acetaminophen === "yes" ? "Sí" : "No"}
            </div>
          `;
        }

        if (answers.symptoms && answers.symptoms.length) {
          html += `
            <div class="summary-item">
              <strong>Síntomas seleccionados:</strong>
              ${answers.symptoms.map((v) => symptomLabels[v] || v).join(", ")}
            </div>
          `;
        }

        const allFeedbackText = Object.values(feedbacks).join(" ");
        const isUrgent =
          allFeedbackText.toLowerCase().includes("urgencias") ||
          allFeedbackText.toLowerCase().includes("signos de alarma");
        const resultClass = isUrgent ? "result-box alarm" : "result-box ok";

        html += `<div class="summary-item ${resultClass}">`;

        ["measured", "temperature", "acetaminophen", "symptoms"].forEach(
          (q) => {
            const feedback = feedbacks[q];
            if (feedback) {
              html += `
                <h4>${getQuestionLabel(q)}</h4>
                ${formatLines(feedback)}
              `;
            }
          }
        );

        html += `</div>`;

        summaryContent.innerHTML = html;
      }

      function shouldStop(question, value) {
        if (question === "measured" && answers.age === "0-3" && value === "no") {
          return true;
        }
        if (question === "temperature" && answers.age === "0-3") {
          return true;
        }
        if (question === "symptoms") {
          return true;
        }
        return false;
      }

      function canAdvance() {
        if (currentStep === "summary" || currentStep === "complete") return true;

        const stepEl = container.querySelector(`[data-step="${currentStep}"]`);
        if (!stepEl) return false;

        if (currentStep === 5) {
          const checked = stepEl.querySelectorAll('input[type="checkbox"]:checked');
          return checked.length > 0;
        }

        const checked = stepEl.querySelector('input[type="radio"]:checked');
        return !!checked;
      }

      function handleNext() {
        if (!canAdvance()) return;

        if (currentStep === "summary") {
          form.dispatchEvent(
            new CustomEvent("leadMagnetComplete", {
              bubbles: true,
              detail: { answers, feedbacks },
            })
          );
          showStep("complete");
          return;
        }

        if (currentStep === "complete") {
          window.location.href = "/blackfriday";
          return;
        }

        const stepEl = container.querySelector(`[data-step="${currentStep}"]`);
        const question = stepEl?.getAttribute("data-question");

        let value;
        if (currentStep === 5) {
          value = getCheckboxValues(currentStep);
        } else {
          const checked = stepEl.querySelector('input[type="radio"]:checked');
          value = checked?.value;
        }

        if (question && value !== undefined) {
          answers[question] = value;

          if (currentStep > 1) {
            renderFeedback(question, value);
          }
        }

        if (shouldStop(question, value)) {
          buildSummary();
          showStep("summary");
          return;
        }

        if (currentStep < TOTAL_QUESTIONS) {
          showStep(currentStep + 1);
        } else {
          buildSummary();
          showStep("summary");
        }
      }

      function handlePrev() {
        if (currentStep === "summary") {
          showStep(TOTAL_QUESTIONS);
          return;
        }

        if (currentStep === "complete") {
          return;
        }

        if (currentStep > 1) {
          showStep(currentStep - 1);
        }
      }

      function handleOptionClick(input) {
        if (currentStep === "summary") return;

        const question = input
          .closest("[data-question]")
          ?.getAttribute("data-question");
        if (!question) return;

        if (input.type === "checkbox") {
          const stepEl = input.closest('[data-step]');
          const checked = stepEl.querySelectorAll('input[type="checkbox"]:checked');
          answers[question] = Array.from(checked).map((el) => el.value);
          renderFeedback(question, answers[question]);
        } else {
          answers[question] = input.value;

          if (currentStep > 1) {
            renderFeedback(question, input.value);
          }
        }

        if (nextBtn) {
          nextBtn.disabled = false;
          nextBtn.classList.remove("btn-disabled");
        }
      }

      nextBtn?.addEventListener("click", handleNext);
      prevBtn?.addEventListener("click", handlePrev);

      const optionCards = container.querySelectorAll(".option-card input");
      optionCards.forEach((input) => {
        input.addEventListener("change", () => {
          handleOptionClick(input);
        });
      });

      showStep(1);
    });
  });
</script>

<style>
  .lead-magnet {
    width: 100%;
    max-width: 720px;
    margin: 0 auto;
    padding: 1rem;
  }

  .lead-magnet-card {
    background: white;
    border-radius: 24px;
    padding: 2rem;
    box-shadow: var(--shadow-lg);
    border: 1px solid rgba(0, 0, 0, 0.05);
  }

  .lead-magnet-header {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .lead-magnet-header h2 {
    margin: 0;
    color: var(--color-dark);
    font-size: var(--text-2xl);
  }

  .lead-magnet-header p {
    margin-top: 0.75rem;
    color: var(--color-gray);
    line-height: 1.6;
  }

  .progress-bar {
    width: 100%;
    height: 8px;
    background: var(--color-light-gray);
    border-radius: 999px;
    overflow: hidden;
    margin-bottom: 1.5rem;
  }

  .progress-fill {
    height: 100%;
    width: 0%;
    background: linear-gradient(135deg, #fa6aa5 0%, #e94d91 100%);
    border-radius: 999px;
    transition: width 0.4s ease;
  }

  .lead-magnet-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .question-step {
    border: none;
    padding: 0;
    margin: 0;
  }

  .question-title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-secondary);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-dark);
    margin-bottom: 1.25rem;
    line-height: 1.4;
  }

  .question-title em {
    font-weight: 500;
    font-size: var(--text-base);
    color: var(--color-gray);
    font-style: normal;
  }

  .question-number {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    min-width: 36px;
    background: linear-gradient(135deg, #fa6aa5 0%, #e94d91 100%);
    color: white;
    border-radius: 50%;
    font-size: var(--text-base);
    font-weight: 700;
  }

  .options {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .option-card {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 1rem 1.15rem;
    border: 2px solid #ececec;
    border-radius: 14px;
    cursor: pointer;
    transition: all 0.25s ease;
    background: white;
  }

  .option-card:hover {
    border-color: var(--color-pink);
    box-shadow: 0 4px 12px rgba(250, 106, 165, 0.1);
  }

  .option-card:has(input:checked) {
    border-color: var(--color-pink);
    background: #fff3f8;
    box-shadow: 0 4px 16px rgba(250, 106, 165, 0.15);
  }

  .option-card input {
    width: 20px;
    height: 20px;
    accent-color: var(--color-pink);
    cursor: pointer;
    flex-shrink: 0;
  }

  .option-text {
    font-size: var(--text-base);
    color: var(--color-dark);
    font-weight: 500;
    line-height: 1.4;
  }

  .feedback {
    margin-top: 1rem;
    padding: 1rem 1.25rem;
    border-radius: 14px;
    background: #f0f9ff;
    border-left: 4px solid #38bdf8;
    color: var(--color-dark);
  }

  .feedback p {
    margin: 0;
    color: var(--color-dark);
    line-height: 1.6;
  }

  .feedback p + p {
    margin-top: 0.5rem;
  }

  .summary-step {
    animation: fadeIn 0.4s ease;
  }

  .summary-header {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .summary-header h3 {
    color: var(--color-dark);
    margin: 0;
  }

  .summary-header p {
    margin-top: 0.5rem;
  }

  .summary-content {
    display: flex;
