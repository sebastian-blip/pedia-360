---
import MainLayout from '../layouts/MainLayout.astro';
import LeadMagnetNutricion from '../components/LeadMagnetNutricion.astro';
---

<MainLayout title="Evaluación de nutrición - Pedia360" description="Evalúa si tu hijo entre 6 meses y 2 años está comiendo lo que necesita.">
  <main class="evaluacion-page">
    <section class="evaluacion-hero">
      <h1>Evaluación de alimentación</h1>
      <p>Descubre en minutos si tu bebé está recibiendo los alimentos que necesita para crecer sano y feliz.</p>
    </section>

    <LeadMagnetNutricion />
  </main>
</MainLayout>

<style>
  .evaluacion-page {
    min-height: 100vh;
    background: linear-gradient(180deg, #fff5f8 0%, #ffffff 100%);
    padding: 3rem 1rem;
  }

  .evaluacion-hero {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 2rem;
  }

  .evaluacion-hero h1 {
    color: var(--color-dark);
    font-size: var(--text-3xl);
    margin-bottom: 0.75rem;
  }

  .evaluacion-hero p {
    color: var(--color-gray);
    font-size: var(--text-lg);
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .evaluacion-page {
      padding: 2rem 1rem;
    }

    .evaluacion-hero h1 {
      font-size: var(--text-2xl);
    }
  }
</style>
